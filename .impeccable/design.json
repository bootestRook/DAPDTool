  "narrative": {
    "northStar": "浅色原生任务工作台",
    "overview": "范围仅为独立 DAPD 工具，依据 `dapd_tool/ui.py`、`updates_ui.py`、`content_editor.py` 与 `media.py` 的当前实现记录。用户已确认 Python + PySide6 的原生 Windows Qt Widgets 方案；以浅色、系统中文字体和直接操作支撑办公屏幕中的高频任务管理。模板主任务与各级子任务均支持固定描述、内嵌图片和附件。\n\n采用 Operate 模式，标准 Qt 控件与 Fusion 样式。DESIGN_VARIANCE=3，MOTION_INTENSITY=1，VISUAL_DENSITY=5。无装饰图片、无自定义动画。方向脚本已运行（91dbc398）；视觉方向由已确认的原生工具方案与既有桌面风格约束。网页检测器不适用于此界面。",
    "keyCharacteristics": [
      "浅灰背景、白色操作区与单一青绿主色。",
      "标准原生控件、清楚的文字状态和可见键盘焦点。",
      "中等信息密度、可调分栏和可伸展内容区。",
      "必要说明常显，所有悬停文字说明均禁用。"
    ],
    "rules": [
      {
        "name": "The Visible Status Rule",
        "body": "状态必须使用具体文字说明；颜色、进度条和标签下划线只提供辅助识别。",
        "section": "colors"
      },
      {
        "name": "The Action Matches State Rule",
        "body": "按钮可用状态、动作名称与紧邻说明必须同步；操作结束后不得保留仍需等待的文字。",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** 保持可见键盘焦点、明确的任务归属、真实进度与先预览后提交的操作顺序。",
      "**Do** 让说明直接显示在界面中，错误恢复入口与相关记录放在一起。"
    ],
    "donts": [
      "**Don't** 添加默认任务模板、装饰图片、网页视觉套路或悬停文字说明。",
      "**Don't** 将本文件的界面约定扩展到原有飞书控制器。"
    ]
  }
